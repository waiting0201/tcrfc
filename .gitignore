# ── 客戶素材收件夾 ───────────────────────────────
# 內含未成年學員照片、球員個資與未授權的肖像素材，
# 且體積大（數百張原始照片），一律不進版控。
# 結構若有調整，請改用 docs/07-content-pipeline.md 記錄，不要提交資料夾本身。
TCRFC_資料收件夾/
TCRFC_資料收件夾.zip

# 打包產物（收件夾 zip 會隨結構調整重新產生）
*.zip

# ── 系統與工具 ───────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Cloudflare Wrangler 快取（含 account_id，勿提交）
.wrangler/

# ── 開發相依與建置產物（網站開發階段用得到）─────────
node_modules/
dist/
build/
.vite/
*.log
.env
.env.*
!.env.example
apps/*/.output/
apps/*/.nuxt/
apps/*/bin/
apps/*/obj/

# ── 部署（S0-7a）：本機開發用機密與轉檔產物，範本／設定本身要納管 ──────
# docs/20-cicd.md §7.2：機密一律不進 git，只有 *.env.example 範本納管。
deploy/dev/club.env
deploy/dev/charity.env
# deploy/local-ddl.sh 的輸出（db/*.sql 轉成本機 SQL Server 相容版），隨時可重跑重建
deploy/dev/.local-ddl-output/

# db/seed/generate-club-seed-sql.py 的輸出：含 site/src/data/*.json 的球員／教練真實姓名，
# 讀 JSON 產生的衍生檔，隨時可用 db/seed/apply-seed.sh 重新產生，不需要進版控。
db/seed/.generated/

# ── 暫存 ────────────────────────────────────────
*.tmp
*.bak
~$*

# 網站建置產物
site/dist/

# 客戶照片：從收件夾轉檔的衍生物，含未成年學員肖像。
# 授權未逐項確認前不納入有遠端的版控。
# 重建方式：bash site/tools/build-images.sh
site/src/assets/img/

# 🔴 同一批照片在 Nuxt 專案裡的複本（S0-9 搬遷時自 site/src/assets/img/ rsync 過去，
# 159 檔／59MB）。⛔ 這一條漏掉就等於把未成年學員肖像推上公開 repo——
# 上面那條規則寫的是舊路徑，檔案換位置時規則不會自己跟過去（見 docs/18 E-26）。
# 重建方式：rsync -a --ignore-existing site/src/assets/img/ apps/web/public/assets/img/
apps/web/public/assets/img/

# ── 客戶提供素材 ─────────────────────────────────
# Logo 主檔 TCR_logo_CMYK.ai、品牌簡報 pptx、sitemap 圖、參考網站截圖，
# 以及台灣足球策略發展協會的立案證書與負責人當選證明（含負責人姓名與出生日期）。
# 屬客戶資產且含個資，不進版控——GitHub repo 是公開的。
# 備份走 NAS 的檔案層（Remote_NAS 只是離線備份 remote，內容與 GitHub 相同）。
# 文件裡引用它的路徑仍然有效，只是 clone 下來不會有檔案。
reference/

# ── 交付物的產生物 ───────────────────────────────
# 真實來源是母檔：規劃書與里程碑的 .md、里程碑的 .html、output/tools/ 的腳本。
# 以下是產生物，不進版控，隨時可重建：
#   node output/tools/build-pdf.mjs           → 十二份 PDF
#   python3 output/tools/build-sitemap.py     → 慈善站台地圖中英 HTML
#   python3 output/tools/build-app-brief.py   → 行動 App 客戶版中英 HTML
output/*.pdf
output/TCRFC_慈善捐款站台地圖.html
output/TCRFC_Charity_Donation_Sitemap_EN.html
output/TCRFC_行動App功能說明_客戶版.html
output/TCRFC_Mobile_App_Feature_Overview_EN.html
