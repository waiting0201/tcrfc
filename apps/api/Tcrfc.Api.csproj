<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ⚠️ 不開 InvariantGlobalization：Microsoft.Data.SqlClient 連 SQL Server 需要完整 ICU
         全球化支援，開了這個旗標會讓每次連線在 TryOpen 階段直接丟
         System.NotSupportedException（本機實測發現，見 docs/18-work-errors.md）。 -->
    <!-- apps/api/Dockerfile 的 build 階段假設 packages.lock.json 已提交且用 locked-mode 還原
         （docs/20-cicd.md §3 NuGet 快取策略），這裡開啟鎖定檔生成。 -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- apps/api/Dockerfile 的 ENTRYPOINT 寫死 Tcrfc.Api.dll，元件名稱不得改動。 -->
    <AssemblyName>Tcrfc.Api</AssemblyName>
    <RootNamespace>Tcrfc.Api</RootNamespace>
    <UserSecretsId>3f8c9a9a-3f2c-4b1a-9e1a-tcrfc-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.86" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.3.0" />
    <!-- 寫入端一次性 handoff（docs/20-cicd.md §5）：唯讀查詢仍走 Dapper，不受此影響。
         Design 套件只在建置期（scaffold／migrations）用得到，執行期不需要，故 PrivateAssets="all"
         （不會被打進最終輸出、也不會被下游專案間接參照）。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- S0-8 圖片上傳共用元件：伺服器端重新編碼（docs/17-deployment.md §6 已定案理由：
         年營收 100 萬美元以下適用 Apache 2.0，俱樂部與協會均符合，此前提要記錄）。
         ⚠️ ImageSharp 不解 HEIC/HEIF——伺服器端一律以此為準判斷「解不開＝格式不支援」。 -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- 物件儲存：正式環境接 Azure Blob，本機開發接 Azurite（見 README「本機開發：Azurite」）。 -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
  </ItemGroup>

  <!-- Tcrfc.Api.Tests（S0-7d）是本目錄底下的獨立子專案，沒有 .sln 把兩者的建置範圍分開，
       預設的遞迴 **/*.cs 萬用字元會把測試專案的原始碼一起吃進來（測試專案參照 xunit／
       Microsoft.AspNetCore.Mvc.Testing，本專案完全沒有這些套件，會直接編譯失敗）。明確排除。 -->
  <ItemGroup>
    <Compile Remove="Tcrfc.Api.Tests/**/*.cs" />
    <Content Remove="Tcrfc.Api.Tests/**/*" />
    <None Remove="Tcrfc.Api.Tests/**/*" />
  </ItemGroup>

</Project>
