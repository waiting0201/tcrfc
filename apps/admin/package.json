{
  "name": "@tcrfc/admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc -b --noEmit",
    "lint:eslint": "eslint .",
    "lint:forbidden-terms": "node scripts/check-forbidden-terms.mjs",
    "lint": "npm run lint:node-version && npm run lint:eslint && npm run lint:forbidden-terms && npm run lint:contrast && npm run lint:editview-reactivity",
    "lint:contrast": "node scripts/check-contrast.mjs",
    "lint:editview-reactivity": "node scripts/check-editview-reactivity.mjs",
    "lint:node-version": "node ../../scripts/check-node-version.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "element-plus": "2.9.1",
    "heic2any": "^0.0.4",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.5",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/eslint-config-typescript": "14.2.0",
    "eslint": "9.17.0",
    "eslint-plugin-vue": "9.32.0",
    "globals": "15.14.0",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vue-tsc": "2.2.0"
  }
}
