# deploy/dev/club.env.example — api 服務本機開發用「俱樂部」機密範本
#
# 複製為 deploy/dev/club.env（該檔已被 .gitignore 排除）後填值。
# 對照正式環境見 docs/20-cicd.md §7.2（正式環境放在 VM 的 /opt/tcrfc/secrets/club.env，不進 git）。
# 本機開發一律指向 docker-compose.dev.yml 起的 mssql-dev 服務，不是 Azure SQL。

# api 連本機 mssql-dev 的「俱樂部」資料庫。密碼需與 docker-compose.dev.yml 給 mssql-dev 的
# MSSQL_DEV_SA_PASSWORD 一致（本機開發圖方便直接用 sa，正式環境不會這樣做）。
CLUB_SQL_CONNECTION_STRING=Server=mssql-dev,1433;Database=tcrfc_club_dev;User Id=sa;Password=ChangeMe_Local123!;TrustServerCertificate=True;

# api 連 redis 容器
REDIS_PASSWORD=change-me-local-redis-password

# 官網商店結帳＋藍鯨代收代付——本機一律用 LINE Pay Sandbox 憑證，不得填正式商店號金鑰
LINE_PAY_CLUB_CHANNEL_ID=sandbox-channel-id
LINE_PAY_CLUB_CHANNEL_SECRET=sandbox-channel-secret

# 電子發票（俱樂部字軌）——本機開發用測試環境金鑰
INVOICE_SERVICE_API_KEY_CLUB=local-dev-placeholder

# 官網前後台登入權杖簽章——本機用任意隨機字串即可，不得沿用正式環境的值
JWT_SIGNING_KEY_CLUB=local-dev-jwt-signing-key-change-me

# 會員 LINE 一鍵登入
LINE_LOGIN_CHANNEL_ID=sandbox-login-channel-id
LINE_LOGIN_CHANNEL_SECRET=sandbox-login-channel-secret

# 圖片上傳——本機開發若不接 Azure Blob，可改用 Azurite（Azure Storage 模擬器）的預設連線字串
AZURE_BLOB_CONNECTION_STRING=UseDevelopmentStorage=true

# 推播（後台 M3）——本機開發通常不需要真的推播，留空或填測試憑證
APNS_KEY_ID=
FCM_SERVICE_ACCOUNT_JSON=
