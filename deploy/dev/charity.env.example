# deploy/dev/charity.env.example — api 服務本機開發用「協會」機密範本
#
# 複製為 deploy/dev/charity.env（該檔已被 .gitignore 排除）後填值。
# 對照正式環境見 docs/20-cicd.md §7.2（正式環境放在 VM 的 /opt/tcrfc/secrets/charity.env，不進 git）。
# 🔴 這是協會的憑證，不得與 club.env 共用任何值（docs/17-deployment.md §5、§14 已明文）。

# api 連宿主機既有 sqlserver 容器裡的「慈善」資料庫（tcrfc_charity_dev），與俱樂部資料庫是
# 同一個 instance 裡的不同 database（本機省一個容器；正式環境是兩個完全獨立的 Azure SQL 單庫，
# 見 docs/17 §5）。2026-09-21 起改連宿主機既有 `sqlserver` 容器，見 club.env.example 開頭說明。
# 密碼＝「本機 SQL Server instance 的 SA 密碼」，須與該既有容器的 MSSQL_SA_PASSWORD 一致。
CHARITY_SQL_CONNECTION_STRING=Server=host.docker.internal,1433;Database=tcrfc_charity_dev;User Id=sa;Password=ChangeMe_Local123!;TrustServerCertificate=True;

# 慈善捐款——本機一律用 LINE Pay Sandbox 憑證，且必須與 club.env 的憑證不同組
LINE_PAY_ASSOCIATION_CHANNEL_ID=sandbox-association-channel-id
LINE_PAY_ASSOCIATION_CHANNEL_SECRET=sandbox-association-channel-secret

# 電子發票（協會字軌，不得共用俱樂部字軌，STATUS B-10）
INVOICE_SERVICE_API_KEY_CHARITY=local-dev-placeholder-charity

# 慈善後台獨立帳號體系的權杖簽章（獨立 2FA，docs/17 §5）
JWT_SIGNING_KEY_CHARITY=local-dev-jwt-signing-key-charity-change-me

# 若慈善圖片改走獨立 Storage Account（docs/20-cicd.md §7.2 待確認項），本機先比照 club 用 Azurite
AZURE_BLOB_CONNECTION_STRING_CHARITY=UseDevelopmentStorage=true
