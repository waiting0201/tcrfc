# deploy/Caddyfile.prelaunch — 正式 VM 在「正式網址到位前」用的 proxy 設定
#
# 🔴 這不是第三套環境。本專案只有兩套環境：**本機開發**（docker-compose.dev.yml）與
# **正式 VM**（docker-compose.yml）。這份檔案是同一台正式 VM、同一批容器、同一個資料庫，
# 在藍鯨網域（STATUS.md B-4）／慈善網域（B-7）尚未到位、主站尚未從 Wix 切換前，
# proxy 暫時改掛的設定。對應 docs/17-deployment.md §10。
#
# 用法：不需要 override 檔，只在 .env 指定這個路徑即可——
#   CADDYFILE=./deploy/Caddyfile.prelaunch
#   docker compose up -d
# 切正式網址時把 .env 的 CADDYFILE 註解掉（回到預設的 deploy/Caddyfile）、六個網域值與
# SITE_ENV 換成正式值，重新 `docker compose up -d`。只有 proxy 的設定來源變了會被重建，
# 其餘容器的映像檔與設定沒變，不受影響。
#
# 這正是 docs/13-blue-whale-site.md §6 紀律 7、8「網域只能在 docker run 階段給」的精神：
# 同一份 compose 結構，換 .env 的值就是換階段，不需要換檔案、不需要改程式碼。
#
# 對正式版（deploy/Caddyfile）只做一件事：三個公開前台（主站／藍鯨／慈善）加一道
# HTTP Basic Auth，擋掉沒有帳密的訪客與所有爬蟲——這是 docs/17 §10.4 三層防護裡唯一
# 真正的技術屏障；另外兩層（X-Robots-Tag 標頭、robots.txt 全擋）由 Nuxt 應用層依
# NUXT_PUBLIC_SITE_ENV=prelaunch 輸出（見 docker-compose.yml 與 docs/17 §10.2、§10.4），
# 不在這裡重複。
#
# 兩個後台（admin-web／admin-charity）不在這裡額外加 Basic Auth：
#   - 它們本來就有自己的登入系統與 2FA，上線前到上線後都一樣要先登入才能用；
#   - X-Robots-Tag noindex 對它們是「永久規則」，已經寫在 deploy/Caddyfile（正式版）裡，
#     這裡沿用同一份不用重複；
#   - 建議另外用 Cloudflare Access（在 Cloudflare 端設定 email 一次性驗證碼政策）加一層
#     網路層防護，理由與怎麼做見 docs/17-deployment.md §10.4——那是 Cloudflare 端設定，
#     不動這份檔案。
#
# 帳密怎麼產生（在 VM 或本機執行，caddy 執行檔內建這個子指令）：
#   caddy hash-password --plaintext '<選一組密碼，不要沿用任何正式環境密碼>'
# 把輸出的雜湊值填進 .env 的 PRELAUNCH_BASIC_AUTH_HASH，使用者名稱填進 PRELAUNCH_BASIC_AUTH_USER。
# 🔴 這兩個變數在 docker-compose.yml 裡是「可為空」的（正式期用不到），所以掛了這份檔案卻
# 忘記填值時，Caddy 會在啟動時因為 bcrypt 雜湊解不出來而失敗——那是刻意的：寧可起不來，
# 也不要悄悄變成一個沒有帳密保護的公開測試站。

{
	servers {
		trusted_proxies static \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
			197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
	email {$ACME_EMAIL}
}

# 三個公開前台共用的「上線前閘門」：Basic Auth ＋ 保險用的 X-Robots-Tag（見檔頭說明，
# 正式的 noindex 輸出來自 Nuxt 應用層的 NUXT_PUBLIC_SITE_ENV，這裡是額外一層而不是唯一來源）。
(prelaunch_gate) {
	basic_auth {
		{$PRELAUNCH_BASIC_AUTH_USER} {$PRELAUNCH_BASIC_AUTH_HASH}
	}
	header X-Robots-Tag "noindex, nofollow, noarchive"
}

# ── 主站（上線前暫用網址） ───────────────────────────────────────────────
{$TCRFC_DOMAIN} {
	import prelaunch_gate
	encode zstd gzip
	reverse_proxy nuxt-tcrfc:3000
}

# ── 台中藍鯨官網（上線前暫用網址） ────────────────────────────────────────
{$BW_DOMAIN} {
	import prelaunch_gate
	encode zstd gzip
	reverse_proxy nuxt-bw:3000
}

# ── 慈善捐款平台前台（上線前暫用網址，🔴 僅供開發測試，不得印上任何對外物料） ───
{$CHARITY_DOMAIN} {
	import prelaunch_gate
	encode zstd gzip
	reverse_proxy nuxt-charity:3000
}

# ── 官網共用後台：不加 Basic Auth（見檔頭說明），noindex 沿用正式版設定 ────
{$ADMIN_WEB_DOMAIN} {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	encode zstd gzip
	reverse_proxy admin-web:8080
}

# ── 慈善平台獨立後台 ──────────────────────────────────────────────────
{$ADMIN_CHARITY_DOMAIN} {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	encode zstd gzip
	reverse_proxy admin-charity:8080
}

# ── API：不對瀏覽器直接顯示內容頁面，不需要 Basic Auth；標頭仍加，屬保險 ────
{$API_DOMAIN} {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	reverse_proxy api:8080
}
