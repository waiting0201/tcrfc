# deploy/Caddyfile.prelaunch — 正式 VM 在「正式網址到位前」用的 proxy 設定
#
# 🔴 這不是第三套環境。本專案只有兩套環境：**本機開發**（docker-compose.dev.yml）與
# **正式 VM**（docker-compose.yml）。這份檔案是同一台正式 VM、同一批容器、同一個資料庫，
# 在藍鯨網域（STATUS.md B-4）／慈善網域（B-7）尚未到位、主站尚未從 Wix 切換前，
# proxy 暫時改掛的設定。對應 docs/17-deployment.md §10。
#
# 用法：不需要 override 檔，只在 .env 指定這個路徑即可——
#   CADDYFILE=./deploy/Caddyfile.prelaunch
#   docker compose up -d
# 切正式網址時把 .env 的 CADDYFILE 註解掉（回到預設的 deploy/Caddyfile）、六個網域值與
# SITE_ENV 換成正式值，重新 `docker compose up -d`。只有 proxy 的設定來源變了會被重建，
# 其餘容器的映像檔與設定沒變，不受影響。
#
# 這正是 docs/13-blue-whale-site.md §6 紀律 7、8「網域只能在 docker run 階段給」的精神：
# 同一份 compose 結構，換 .env 的值就是換階段，不需要換檔案、不需要改程式碼。
#
# 對正式版（deploy/Caddyfile）只做一件事：三個公開前台（主站／藍鯨／慈善）加一道
# X-Robots-Tag "noindex, nofollow, noarchive" 標頭（docs/17 §10.4 兩層防護的第二層）。
# 🔴 測試站沒有帳密（2026-10-02 使用者決定拿掉 Basic Auth）：知道網址即可瀏覽，背後是正式資料庫。
# 另一層（X-Robots-Tag 標頭與 robots.txt 全擋）由 Nuxt 應用層依 NUXT_PUBLIC_SITE_ENV=prelaunch 輸出
# （見 docker-compose.yml 與 docs/17 §10.2、§10.4），這裡是重複保險。
#
# 兩個後台（admin-web／admin-charity）在這裡也沒有額外動作：
#   - 它們本來就有自己的登入系統與 2FA，上線前到上線後都一樣要先登入才能用；
#   - X-Robots-Tag noindex 對它們是「永久規則」，已經寫在 deploy/Caddyfile（正式版）裡，
#     這裡沿用同一份不用重複；
#   - 建議另外用 Cloudflare Access（在 Cloudflare 端設定 email 一次性驗證碼政策）加一層
#     網路層防護，理由與怎麼做見 docs/17-deployment.md §10.4——那是 Cloudflare 端設定，
#     不動這份檔案。
{
	servers {
		trusted_proxies static \
 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
	email {$ACME_EMAIL}
}

# 三個公開前台共用的「上線前閘門」：保險用的 X-Robots-Tag（見檔頭說明，
# 正式的 noindex 輸出來自 Nuxt 應用層的 NUXT_PUBLIC_SITE_ENV，這裡是額外一層而不是唯一來源）。
# 2026-10-02 使用者決定拿掉 Basic Auth（測試站不需帳密即可瀏覽）；只保留 noindex 標頭。
# 不被索引仍由 Nuxt 依 NUXT_PUBLIC_SITE_ENV=prelaunch 輸出的 X-Robots-Tag／robots.txt 全擋負責（docs/17 §10.4）。
(prelaunch_gate) {
	header X-Robots-Tag "noindex, nofollow, noarchive"
}

# ── S1-17 修正（2026-09-29）：明確傳訪客真實 IP 給三個 Nuxt 前台，理由與正式版
# deploy/Caddyfile 完全相同（同一份 trusted_proxies／client_ip_headers 全域設定），見那份檔案
# 對應段落的完整說明，這裡不重複。

# ── 主站（上線前暫用網址） ───────────────────────────────────────────────
{$TCRFC_DOMAIN} {
	import prelaunch_gate
	encode zstd gzip
	reverse_proxy nuxt-tcrfc:3000 {
		header_up X-Real-IP {client_ip}
	}
}

# ── 台中藍鯨官網（上線前暫用網址） ────────────────────────────────────────
{$BW_DOMAIN} {
	import prelaunch_gate
	encode zstd gzip
	reverse_proxy nuxt-bw:3000 {
		header_up X-Real-IP {client_ip}
	}
}

# ── 慈善捐款平台前台（上線前暫用網址，🔴 僅供開發測試，不得印上任何對外物料） ───
{$CHARITY_DOMAIN} {
	import prelaunch_gate
	encode zstd gzip
	reverse_proxy nuxt-charity:3000 {
		header_up X-Real-IP {client_ip}
	}
}

# ── 官網共用後台：不額外加閘門（見檔頭說明），noindex 沿用正式版設定 ────
{$ADMIN_WEB_DOMAIN} {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	encode zstd gzip
	reverse_proxy admin-web:8080
}

# ── 慈善平台獨立後台 ──────────────────────────────────────────────────
{$ADMIN_CHARITY_DOMAIN} {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	encode zstd gzip
	reverse_proxy admin-charity:8080
}

# ── API：不對瀏覽器直接顯示內容頁面，不需要閘門；標頭仍加，屬保險 ────
# 🔴🔴 這是修一個原本就存在、未被發現的漏洞，不是縱深防禦，理由同正式版
# deploy/Caddyfile 對應段落（已本機實測驗證，不是只讀文件推論）。
{$API_DOMAIN} {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	reverse_proxy api:8080 {
		header_up X-Forwarded-For {client_ip}
	}
}
