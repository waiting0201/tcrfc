# .env.example — docker-compose.yml／docker-compose.dev.yml 用的環境變數範本
#
# 用法：cp .env.example .env，再填真實值。.env 本身不納版控（.gitignore 已排除，見那份檔案的
# 「開發相依與建置產物」段）。
#
# 🔴 本檔只放「這兩份 compose 檔本身要用」的變數（網域、映像檔 tag、Redis／本機資料庫密碼）。
# 應用程式真正的機密（LINE Pay 憑證、JWT 簽章金鑰、資料庫連線字串、發票金鑰……）**不放這裡**：
#   - 正式環境：docs/20-cicd.md §7.2，放 VM 的 /opt/tcrfc/secrets/club.env｜charity.env（不進 git）
#   - 本機開發：deploy/dev/club.env｜charity.env（範本在 deploy/dev/*.env.example，同樣不進 git）
# 這個切分本身就是 docs/20 §7.2 的設計原則——能不進 GitHub Secrets／不進這個公開 repo 的機密，
# 一律留在它該待的地方。
#
# 對應 docs/20-cicd.md §3（五個映像檔）、§7（Secrets 清單）；docs/17-deployment.md §1（八個容器）。

# ── 映像檔來源（docs/20-cicd.md §2：GHCR，套件公開，VM 不需要登入憑證） ──────────────
GHCR_OWNER=waiting0201
# 部署一律用 git SHA 當 tag（docs/20-cicd.md §6），這裡的 latest 只給本機手動測試用預設值；
# 正式部署由 deploy.yml 覆寫成實際的 SHA，不依賴這個預設值。
IMAGE_TAG=latest

# ── 網域（依 docs/17 §1／§3，proxy 依 Host 分流） ────────────────────────────────
# 🔴 以下除 TCRFC_DOMAIN 外，其餘網域尚未確定（見 STATUS.md 阻塞清單：藍鯨網域、慈善網域未到位）。
# 下方是範例格式，正式使用前務必替換成真實網域，否則 Caddy 會用這些假網域去嘗試簽發 TLS 憑證並失敗。
TCRFC_DOMAIN=tcrfc.tw
BW_DOMAIN=example-bw.tw
CHARITY_DOMAIN=example-charity.tw
ADMIN_WEB_DOMAIN=admin.tcrfc.tw
ADMIN_CHARITY_DOMAIN=admin.example-charity.tw
API_DOMAIN=api.tcrfc.tw

# Let's Encrypt 到期與帳號通知信箱（deploy/Caddyfile 的 email 指令）
ACME_EMAIL=ops@example.tw

# ── Redis（docs/17 §1，只服務俱樂部，慈善不得接觸） ─────────────────────────────
REDIS_PASSWORD=change-me-strong-random-password

# ── 僅本機開發（docker-compose.dev.yml 的 mssql-dev 服務） ───────────────────────
# 🔴 只用於本機，絕對不要填正式密碼、也不要把這個值帶去任何正式環境的變數。
MSSQL_DEV_SA_PASSWORD=ChangeMe_Local123!
